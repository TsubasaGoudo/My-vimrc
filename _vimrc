"####################
" vimrc 
" Author:Tsubasa Goudo
"####################



" Save the file in UTF-8
set fileencoding=utf-8

" Set langage to English
set langmenu=en
language messages en

"Display line numbers
set number 

"Set tab-width to 4
set tabstop=4 

" Don't create backup files
set nobackup 

" Don't create backup files when overwriting
set nowritebackup 

" Don't create swap files
set noswapfile 

" Syntax highlighting
syntax on

" File type detection
filetype plugin indent on

" The cursor can be moved one character beyond the end of the line
set virtualedit=onemore

" Switch buffer even without saving
set hidden



